{
  "name": "mynder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsx --test document.test.mjs storage.test.mjs backup.test.mjs edit.test.mjs sync.test.mjs",
    "mcp:test": "npm --prefix worker test",
    "mcp:dry-run": "npm --prefix worker run deploy -- --dry-run --config ./wrangler.jsonc",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name mynder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.142.0"
  }
}
