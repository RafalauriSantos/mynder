{
  "name": "mynder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --project tsconfig.server.json && vite build",
    "test": "node --test document.test.mjs storage.test.mjs backup.test.mjs src/sync/contracts.test.mjs",
    "test:cloudflare": "vitest run --config vitest.config.ts",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler pages deploy dist --project-name mynder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "latest",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
