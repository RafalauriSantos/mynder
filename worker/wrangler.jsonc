{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mynder-mcp-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": { "enabled": true },
  "vars": { "MCP_ALLOWED_ORIGIN": "https://mynder.pages.dev", "APP_ORIGIN": "https://mynder.pages.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mynder-staging",
      "database_id": "e1d05623-eaac-4022-885c-46e59d173292",
      "migrations_dir": "src/db/migrations"
    }
  ]
}
