{
  "name": "mynder-mcp-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "cloudflare:configure": "node scripts/configure-cloudflare.mjs",
    "cloudflare:migrations:staging": "wrangler d1 migrations list mynder-staging --remote --config .wrangler/wrangler.generated.jsonc",
    "cloudflare:migrate:staging": "wrangler d1 migrations apply mynder-staging --remote --config .wrangler/wrangler.generated.jsonc",
    "cloudflare:dry-run:staging": "wrangler deploy --dry-run --config .wrangler/wrangler.generated.jsonc",
    "cloudflare:deploy:staging": "wrangler deploy --config .wrangler/wrangler.generated.jsonc",
    "test": "npm --prefix .. run test:cloudflare"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@modelcontextprotocol/client": "2.3.1",
    "typescript": "latest"
  }
}
